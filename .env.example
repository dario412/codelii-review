# Copy to .env.local for optional local testing only.
# On Vercel, set these in: Project → Settings → Environment Variables

# Required — generate with: openssl rand -hex 32
JWT_SECRET=

# Required on Vercel — auto-added when you connect Blob storage to the project
BLOB_READ_WRITE_TOKEN=

# Required — your live Vercel URL (no trailing slash)
SITE_URL=https://your-project.vercel.app

# Required for @mention email notifications and invites — get from https://resend.com/api-keys
RESEND_API_KEY=

# Required for email — must be a verified domain in Resend (e.g. review@yourdomain.com)
# Test mode only: onboarding@resend.dev (sends only to your Resend account email)
RESEND_FROM_EMAIL=review@yourdomain.com

# --- Stripe: $49/month with a 7-day free trial, required to create your own projects ---
# Invited collaborators and share-link guests are never charged.
# Leave STRIPE_SECRET_KEY or STRIPE_PRICE_ID empty to turn billing off entirely.

# Secret key — server only, never expose to the browser. https://dashboard.stripe.com/apikeys
# A restricted key (rk_…) with write access to Customers, Checkout Sessions,
# Subscriptions and Billing Portal is safer than a full secret key.
STRIPE_SECRET_KEY=

# The $49/month price. Create it with: npm run stripe:setup
STRIPE_PRICE_ID=

# Webhook signing secret for POST /api/stripe-webhook. Without it the webhook
# rejects every request — subscription state would silently stop updating.
#   Production: https://dashboard.stripe.com/webhooks → add SITE_URL/api/stripe-webhook
#   Local:      stripe listen --forward-to localhost:3010/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Optional — Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Optional — Slack one-click Connect (Integrations page)
# Create an app at https://api.slack.com/apps → OAuth & Permissions:
#   Redirect URL:  SITE_URL/api/slack-callback
#   Bot Token Scopes: incoming-webhook
# Then copy Client ID + Client Secret here.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional override (defaults to SITE_URL/api/slack-callback)
# SLACK_REDIRECT_URI=https://your-project.vercel.app/api/slack-callback

# Optional — Project management (Comment → task). Shared callback:
#   Redirect URL for all PM apps: SITE_URL/api/pm-callback
# LINEAR: https://linear.app/settings/api → OAuth application (scopes: read, write, issues:create)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# ASANA: https://app.asana.com/0/my-apps → create OAuth app
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# CLICKUP: Workspace Settings → ClickUp API → Create app
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# MONDAY: https://monday.com/developers/apps → OAuth (boards:read boards:write me:read)
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
# JIRA: https://developer.atlassian.com/console/myapps → OAuth 2.0 (3LO)
#   Scopes: read:jira-work write:jira-work read:jira-user offline_access
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# NOTION: https://www.notion.so/my-integrations → Public integration + OAuth
#   After connect, share at least one database with the integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional override (defaults to SITE_URL/api/pm-callback)
# PM_REDIRECT_URI=https://your-project.vercel.app/api/pm-callback

# Optional — Cursor SDK (Fix with Cursor from review comments)
# Get a key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
# Optional model override (default: composer-2.5)
CURSOR_MODEL=composer-2.5

# Optional — GitHub token for private-repo Fix previews AND Comment → GitHub issue.
# Needs repo read + issues:write. Never commit a real token.
GITHUB_TOKEN=

# Who may use the Cursor tools (copy prompt / Fix with Cursor). Project owners
# only, and during beta only these emails. Comma-separated; use * for all owners.
# Default: dario@positivestudio.co
CURSOR_TOOLS_EMAILS=dario@positivestudio.co

# Slack: set Incoming Webhook URLs per client (or per project) in the dashboard.
# No env var required — webhooks are stored on the client/project records.
